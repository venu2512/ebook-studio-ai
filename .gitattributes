# Normalise line endings to LF in the repository; check out native on Windows.
* text=auto eol=lf

# Shell / Docker / Python / JS / TS / Markdown / YAML stay LF.
*.sh   text eol=lf
*.py   text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.mjs  text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.md   text eol=lf

# Windows batch files must check out with CRLF (cmd.exe needs it for labels).
*.bat  text eol=crlf
*.cmd  text eol=crlf
Dockerfile text eol=lf

# Binary assets.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.pdf  binary
*.epub binary
*.woff  binary
*.woff2 binary
