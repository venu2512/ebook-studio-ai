    {
      "name": "Books",
      "item": [
        {
          "name": "Create Book",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.id) {",
                  "    pm.collectionVariables.set('bookId', json.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"topic\": \"Mastering Production Microservices with Go and Kubernetes\",\n  \"title\": \"Ship Reliable Microservices\",\n  \"author_name\": \"Jane Doe\",\n  \"audience\": \"Senior Backend Engineers\",\n  \"category\": \"Technology\",\n  \"language\": \"en\",\n  \"tone\": \"authoritative\",\n  \"target_pages\": 25,\n  \"template\": \"classic\",\n  \"keywords\": [\"go\", \"microservices\", \"kubernetes\"]\n}"
            },
            "url": { "raw": "{{baseUrl}}/books", "host": ["{{baseUrl}}"], "path": ["books"] }
          }
        },
        {
          "name": "List Books",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/books?page=1&page_size=20", "host": ["{{baseUrl}}"], "path": ["books"], "query": [{ "key": "page", "value": "1" }, { "key": "page_size", "value": "20" }] }
          }
        },
        {
          "name": "Get Book by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/books/{{bookId}}", "host": ["{{baseUrl}}"], "path": ["books", "{{bookId}}"] }
          }
        },
        {
          "name": "Get Book Cost Estimate",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/books/{{bookId}}/cost-estimate", "host": ["{{baseUrl}}"], "path": ["books", "{{bookId}}", "cost-estimate"] }
          }
        },
        {
          "name": "Get Running Book Bible",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/books/{{bookId}}/bible", "host": ["{{baseUrl}}"], "path": ["books", "{{bookId}}", "bible"] }
          }
        }
      ]
