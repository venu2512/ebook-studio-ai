              "raw": "{\n  \"structure\": {\n    \"parts\": [\n      {\n        \"title\": \"Foundations\",\n        \"chapters\": [\n          {\n            \"title\": \"Architectural Principles\",\n            \"summary\": \"Core principles of scalable services\",\n            \"key_points\": [\"Decoupled state\", \"Observability first\"],\n            \"word_budget\": 1500\n          }\n        ]\n      }\n    ]\n  }\n}"
            },
            "url": { "raw": "{{baseUrl}}/books/{{bookId}}/outline", "host": ["{{baseUrl}}"], "path": ["books", "{{bookId}}", "outline"] }
          }
        },
        {
          "name": "Approve Outline",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/books/{{bookId}}/outline/approve", "host": ["{{baseUrl}}"], "path": ["books", "{{bookId}}", "outline", "approve"] }
          }
        }
