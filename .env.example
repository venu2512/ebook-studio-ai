# =============================================================================
# eBook Studio AI - environment template
# Copy to `.env` and fill in. Every variable is explained below.
# Docker Compose reads this file from the repository root.
# =============================================================================

# -----------------------------------------------------------------------------
# Core / app
# -----------------------------------------------------------------------------
# development | staging | production
APP_ENV=development
APP_NAME=eBook Studio AI
APP_VERSION=0.1.0
# Comma-separated list of allowed browser origins for CORS.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Public URL of the API (used in emails, Stripe redirects, signed URLs).
API_BASE_URL=http://localhost:8000
# Public URL of the web app.
WEB_BASE_URL=http://localhost:3000
# Root log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Async SQLAlchemy URL. Compose rewrites the host to `postgres` via env override.
# Local dev can point at SQLite: sqlite+aiosqlite:///./ebook_studio.db
DATABASE_URL=postgresql+asyncpg://ebook:ebook@localhost:5432/ebook_studio
# Set true to echo SQL to the log (very noisy).
DB_ECHO=false
# Connection pool sizing (ignored for SQLite).
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# -----------------------------------------------------------------------------
# Redis (queue + cache + rate limiting)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Auth / JWT
# -----------------------------------------------------------------------------
# REQUIRED in production. Generate with: python -c "import secrets;print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
# Cookie domain for the httpOnly refresh cookie (leave blank for localhost).
COOKIE_DOMAIN=
COOKIE_SECURE=false

# Email verification / password reset
REQUIRE_EMAIL_VERIFICATION=false
EMAIL_FROM=no-reply@ebookstudio.local
# smtp | console  (console prints emails to the log - handy in dev)
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true

# Google OAuth (leave blank to disable the Google button)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback/google

# -----------------------------------------------------------------------------
# LLM providers
# -----------------------------------------------------------------------------
# mock | openai_compatible
# `mock` is deterministic and needs no network - used by tests and the demo.
LLM_PROVIDER=mock
# Works with OpenAI, OpenRouter, Groq, Together, vLLM, Ollama, LM Studio, ...
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3
# Per-agent model selection (cheap model for structure, strong model for prose).
LLM_MODEL_DEFAULT=gpt-4o-mini
LLM_MODEL_RESEARCHER=gpt-4o-mini
LLM_MODEL_PLANNER=gpt-4o-mini
LLM_MODEL_WRITER=gpt-4o
LLM_MODEL_EDITOR=gpt-4o-mini
LLM_MODEL_FACT_CHECKER=gpt-4o
LLM_MODEL_DESIGNER=gpt-4o-mini
LLM_MODEL_PUBLISHER=gpt-4o-mini
LLM_MODEL_MARKETER=gpt-4o-mini

# Token budget defaults (hard stops that keep cost predictable).
DEFAULT_BOOK_TOKEN_BUDGET=250000
MAX_CHAPTERS=40

# -----------------------------------------------------------------------------
# Image generation (covers)
# -----------------------------------------------------------------------------
# none | openai_compatible
IMAGE_PROVIDER=none
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-1

# -----------------------------------------------------------------------------
# Object storage (S3 / R2 / MinIO)
# -----------------------------------------------------------------------------
# Set STORAGE_BACKEND=local to write to ./storage instead of S3 (dev only).
STORAGE_BACKEND=local
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=ebook-studio
S3_PUBLIC_BASE_URL=
SIGNED_URL_EXPIRE_SECONDS=3600
LOCAL_STORAGE_DIR=./storage

# -----------------------------------------------------------------------------
# Stripe
# -----------------------------------------------------------------------------
# Leave blank to run in "no billing" mode: credits still work, checkout is disabled.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
# Credit pack price IDs (one-off payments).
STRIPE_PRICE_CREDITS_100=
STRIPE_PRICE_CREDITS_500=
STRIPE_PRICE_CREDITS_2000=

# -----------------------------------------------------------------------------
# Credits economy
# -----------------------------------------------------------------------------
# 1 credit ~= 1,000 LLM tokens of blended cost. Tune freely.
CREDITS_PER_1K_TOKENS=1
FREE_PLAN_MONTHLY_CREDITS=100
PRO_PLAN_MONTHLY_CREDITS=2000
BUSINESS_PLAN_MONTHLY_CREDITS=10000

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
SENTRY_DSN=
# Retention policy for AgentRun prompts/outputs, in days (0 = keep forever).
AGENT_RUN_RETENTION_DAYS=90

# -----------------------------------------------------------------------------
# Worker
# -----------------------------------------------------------------------------
# inline (in-process asyncio task) | arq (dedicated Redis worker)
# `inline` is the default so `docker compose up` works with a single API process.
JOB_EXECUTION_MODE=inline
